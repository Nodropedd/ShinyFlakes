{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "ShinyFlakes",
  "version": "0.1.0",
  "identifier": "com.shinyflakes.wallet",
  "build": {
    "beforeDevCommand": "npm run android-binaries && npm run dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "npm run build && npm run android-binaries",
    "frontendDist": "../dist"
  },
  "app": {
    "withGlobalTauri": false,
    "windows": [
      {
        "label": "main",
        "title": "ShinyFlakes",
        "width": 1060,
        "height": 700,
        "minWidth": 900,
        "minHeight": 620,
        "center": true,
        "resizable": true,
        "skipTaskbar": true,
        "contentProtected": true,
        "dragDropEnabled": false
      }
    ],
    "security": {
      "csp": "default-src 'self'; script-src 'self'; style-src 'self' 'unsafe-inline'; img-src 'self' data:; font-src 'self'; connect-src 'self' ipc: http://ipc.localhost ws://localhost:1420 http://localhost:1420; object-src 'none'; base-uri 'none'; form-action 'none'; frame-ancestors 'none'",
      "assetProtocol": {
        "enable": false
      }
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.png",
      "icons/icon.ico"
    ],
    "windows": {
      "nsis": {
        "installMode": "currentUser"
      }
    },
    "android": {
      "versionCode": 1001
    }
  }
}
